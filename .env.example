# ===========================================
# AlphaResearch Environment Variables
# Copy this file to .env.local and fill in the values
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://alpha:alpha_dev_password@localhost:5432/alpha_research"

# Redis
REDIS_URL="redis://localhost:6379"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (Better Auth) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# AI Provider (Phase 5) — get a free key at https://console.groq.com
GROQ_API_KEY=""

# Financial Data API (Phase 4)
# FINANCIAL_API_KEY=""

# Sentry (Phase 7)
# SENTRY_DSN=""

# PostHog (Phase 7)
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST=""
