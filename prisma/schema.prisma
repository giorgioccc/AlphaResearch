generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Identity & Access Context
// ===========================================

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  role          UserRole         @default(USER)
  plan          SubscriptionPlan @default(FREE)
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  sessions      Session[]
  accounts      Account[]
  workspaces    Workspace[]
  conversations Conversation[]
  reports       Report[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ===========================================
// Company Data Context
// ===========================================

model Company {
  id           String   @id @default(cuid())
  ticker       String   @unique
  name         String
  exchange     String
  sector       String?
  industry     String?
  description  String?  @db.Text
  marketCap    BigInt?
  country      String?
  logoUrl      String?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  financialData  FinancialData[]
  stockPrices    StockPrice[]
  savedCompanies SavedCompany[]
  conversations  Conversation[]
  reports        Report[]

  @@index([ticker])
  @@index([name])
  @@map("companies")
}

enum StatementType {
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
}

enum ReportingPeriod {
  ANNUAL
  QUARTERLY
}

model FinancialData {
  id        String          @id @default(cuid())
  companyId String
  type      StatementType
  period    ReportingPeriod
  date      DateTime        @db.Date
  data      Json
  fetchedAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, period, date])
  @@index([companyId])
  @@map("financial_data")
}

model StockPrice {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(12, 4)
  high      Decimal  @db.Decimal(12, 4)
  low       Decimal  @db.Decimal(12, 4)
  close     Decimal  @db.Decimal(12, 4)
  volume    BigInt
  fetchedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@map("stock_prices")
}

// ===========================================
// AI Research Context
// ===========================================

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  companyId   String?
  workspaceId String?
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId])
  @@index([companyId])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  citations      Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  companyId String
  title     String
  status    ReportStatus @default(PENDING)
  content   String?      @db.Text
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("reports")
}

// ===========================================
// Workspace Context
// ===========================================

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedCompanies SavedCompany[]
  notes          Note[]
  conversations  Conversation[]

  @@index([userId])
  @@map("workspaces")
}

model SavedCompany {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  addedAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, companyId])
  @@map("saved_companies")
}

model Note {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String?
  title       String?
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("notes")
}
